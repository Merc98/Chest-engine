;
; voiceservice32.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
CatalogFile=voiceservice32.cat
DriverVer= ; TODO: set DriverVer in stampinf property pages

[DestinationDirs]
DefaultDestDir = 12
voiceservice32_Device_CoInstaller_CopyFiles = 11

; ================= Class section =====================

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
voiceservice32.sys  = 1,,
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll=1 ; make sure the number matches with SourceDisksNames

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%voiceservice32.DeviceDesc%=voiceservice32_Device, Root\voiceservice32 ; TODO: edit hw-id

[voiceservice32_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
voiceservice32.sys

;-------------- Service installation
[voiceservice32_Device.NT.Services]
AddService = voiceservice32,%SPSVCINST_ASSOCSERVICE%, voiceservice32_Service_Inst

; -------------- voiceservice32 driver install sections
[voiceservice32_Service_Inst]
DisplayName    = %voiceservice32.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\voiceservice32.sys

;
;--- voiceservice32_Device Coinstaller installation ------
;

[voiceservice32_Device.NT.CoInstallers]
AddReg=voiceservice32_Device_CoInstaller_AddReg
CopyFiles=voiceservice32_Device_CoInstaller_CopyFiles

[voiceservice32_Device_CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000, "WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll,WdfCoInstaller"

[voiceservice32_Device_CoInstaller_CopyFiles]
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll

[voiceservice32_Device.NT.Wdf]
KmdfService =  voiceservice32, voiceservice32_wdfsect
[voiceservice32_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ManufacturerName="VoiceService Inc"
ClassName="System" ; TODO: edit ClassName
DiskName = "VoiceService32 Installation Disk"
voiceservice32.DeviceDesc = "VoiceService32 Device"
voiceservice32.SVCDESC = "VoiceService32 Service"
