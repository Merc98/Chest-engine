;
; vsperf2-64.inf
;

[Version]
Signature="$WINDOWS NT$"


Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
CatalogFile=vsperf2-64.cat
DriverVer= ; TODO: set DriverVer in stampinf property pages

[DestinationDirs]
DefaultDestDir = 12
vsperf2-64_Device_CoInstaller_CopyFiles = 11

; ================= Class section =====================


[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
vsperf2-64.sys  = 1,,
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll=1 ; make sure the number matches with SourceDisksNames

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%vsperf2-64.DeviceDesc%=vsperf2-64_Device, Root\vsperf2-64 ; TODO: edit hw-id

[vsperf2-64_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
vsperf2-64.sys

;-------------- Service installation
[vsperf2-64_Device.NT.Services]
AddService = vsperf2-64,%SPSVCINST_ASSOCSERVICE%, vsperf2-64_Service_Inst

; -------------- vsperf2 driver install sections
[vsperf2-64_Service_Inst]
DisplayName    = %vsperf2-64.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\vsperf2-64.sys

;
;--- vsperf2_Device Coinstaller installation ------
;

[vsperf2-64_Device.NT.CoInstallers]
AddReg=vsperf2-64_Device_CoInstaller_AddReg
CopyFiles=vsperf2-64_Device_CoInstaller_CopyFiles

[vsperf2-64_Device_CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000, "WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll,WdfCoInstaller"

[vsperf2-64_Device_CoInstaller_CopyFiles]
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll

[vsperf2-64_Device.NT.Wdf]
KmdfService =  vsperf2-64, vsperf2-64_wdfsect
[vsperf2-64_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ManufacturerName="VoiceService Inc"
ClassName= "System" ; TODO: edit ClassName
DiskName = "vsperf2-64 Installation Disk"
vsperf2-64.DeviceDesc = "vsperf2-64 Device"
vsperf2-64.SVCDESC = "vsperf2-64 Service"
