;
; voiceservice64.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
CatalogFile=voiceservice64.cat
DriverVer= ; TODO: set DriverVer in stampinf property pages

[DestinationDirs]
DefaultDestDir = 12
voiceservice64_Device_CoInstaller_CopyFiles = 11

; ================= Class section =====================

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
voiceservice64.sys  = 1,,
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll=1 ; make sure the number matches with SourceDisksNames

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%voiceservice64.DeviceDesc%=voiceservice64_Device, Root\voiceservice64 ; TODO: edit hw-id

[voiceservice64_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
voiceservice64.sys

;-------------- Service installation
[voiceservice64_Device.NT.Services]
AddService = voiceservice64,%SPSVCINST_ASSOCSERVICE%, voiceservice64_Service_Inst

; -------------- voiceservice64 driver install sections
[voiceservice64_Service_Inst]
DisplayName    = %voiceservice64.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\voiceservice64.sys

;
;--- voiceservice64_Device Coinstaller installation ------
;

[voiceservice64_Device.NT.CoInstallers]
AddReg=voiceservice64_Device_CoInstaller_AddReg
CopyFiles=voiceservice64_Device_CoInstaller_CopyFiles

[voiceservice64_Device_CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000, "WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll,WdfCoInstaller"

[voiceservice64_Device_CoInstaller_CopyFiles]
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll

[voiceservice64_Device.NT.Wdf]
KmdfService =  voiceservice64, voiceservice64_wdfsect
[voiceservice64_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ManufacturerName="VoiceService Inc"
ClassName="System" ; TODO: edit ClassName
DiskName = "VoiceService64 Installation Disk"
voiceservice64.DeviceDesc = "VoiceService64 Device"
voiceservice64.SVCDESC = "VoiceService64 Service"
